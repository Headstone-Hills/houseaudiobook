{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HillAudiobook",
  "version": "0.0.1",
  "identifier": "com.headstonehills.hillaudiobook",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.music",
    "shortDescription": "First-pass audiobook editing, on your Mac only.",
    "copyright": "Headstone Hills",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../build/engine/hillaudio-engine/": "engine/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    }
  }
}
